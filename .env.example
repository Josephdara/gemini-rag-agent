# Copy to .env and fill in from `terraform -chdir=infra output agent_env`. Load with: set -a; source .env; set +a
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=my-rag-agent
GOOGLE_CLOUD_LOCATION=us
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=us-east4
BQ_DATASET=rag
BQ_LOCATION=us-east4
MODEL_ARMOR_TEMPLATE=projects/my-rag-agent/locations/us/templates/baseline
